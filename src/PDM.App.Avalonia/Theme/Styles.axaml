<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PDM premium control styles. Additive polish over the Fluent theme (soft corners, smooth
        hover/press micro-interactions, refined typography, cards and badges). These are Style
        setters rather than full ControlTheme replacements so no Fluent template is torn out - keeps
        the redesign robust and NativeAOT-friendly. Colours come from Theme/Tokens.axaml via
        DynamicResource so light/dark + accent switching recolours everything live.
    -->

    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="12" Width="320">
                <TextBlock Classes="h1" Text="Preview" />
                <Button Classes="brand" Content="Primary action" />
                <Button Content="Secondary action" />
                <TextBox Watermark="Text field" />
                <Border Classes="card">
                    <TextBlock Text="Card surface" />
                </Border>
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!-- ================= Base typography ================= -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppWindowBackgroundBrush}" />
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <!-- Semantic text classes for a consistent type scale. -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>

    <!-- Monochrome Fluent icon glyphs (theme foreground). Segoe Fluent Icons on Win11,
         Segoe MDL2 Assets on Win10 - both ship with Windows. -->
    <Style Selector="TextBlock.glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= Cards ================= -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BoxShadow" Value="0 4 16 0 #14000000" />
    </Style>

    <!-- ================= Buttons ================= -->
    <!-- Smooth press micro-interaction shared by all buttons. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- Primary "brand" button: accent-filled, fully theme/accent-aware and animated. Targets the
         Fluent template's content presenter so the accent survives hover/press states. -->
    <Style Selector="Button.brand /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.brand:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.brand:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
    </Style>
    <Style Selector="Button.brand">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Destructive button: filled red, for irreversible actions (delete / deactivate). -->
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StatusErrorBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Quiet toolbar/icon button: transparent until hovered. -->
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>

    <!-- ================= Inputs ================= -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="31" />
        <Setter Property="Padding" Value="9,6" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="31" />
    </Style>
    <Style Selector="NumericUpDown">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="MinHeight" Value="31" />
    </Style>

    <!-- ================= Progress ================= -->
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppTrackBrush}" />
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <!-- ================= Status badge (pill) ================= -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================= DataGrid (downloads list) ================= -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource AppRowHoverBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource AppSelectionBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>
    <Style Selector="DataGridCell:focus /template/ Rectangle#FocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- Hide the single-cell "current cell" indicator too. Selecting a row otherwise draws a
         contrasting outline (light on the dark theme, dark on the light theme) around just the
         clicked cell, which reads as a stray border. The full-row selection highlight
         (DataGridRow:selected) already communicates the selection, so the per-cell box is noise. -->
    <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ================= Category sidebar list ================= -->
    <Style Selector="ListBox.categories">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.categories ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.categories ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppHoverBrush}" />
    </Style>
    <Style Selector="ListBox.categories ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}" />
    </Style>
    <Style Selector="ListBox.categories ListBoxItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================= Tooltips ================= -->
    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    </Style>

</Styles>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        x:Class="PDM.App.Avalonia.Views.BrowserSetupWindow"
        x:DataType="vm:BrowserSetupViewModel"
        Title="Browser setup"
        Width="620" Height="480"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" Text="Connect your browser" FontSize="17" FontWeight="SemiBold"
                   Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding SummaryText}" TextWrapping="Wrap"
                   Opacity="0.75" Margin="0,0,0,10" />

        <!-- Three plain steps, so there is no guesswork. PDM pre-authorises the extension, so after
             "Add" the browser's own confirmation is the only click left. -->
        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                Background="{DynamicResource AppAccentSubtleBrush}">
            <StackPanel Spacing="4">
                <TextBlock Text="1.  Click &#x201C;Add to …&#x201D; below — it opens your browser's extension store."
                           TextWrapping="Wrap" />
                <TextBlock Text="2.  In the browser, click &#x201C;Add extension&#x201D; to confirm."
                           TextWrapping="Wrap" />
                <TextBlock Text="3.  Done. Downloads you start in the browser now come to PDM automatically."
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Remove integration" Command="{Binding UnregisterAllCommand}" />
            <Button Content="Close" MinWidth="90" Click="OnClose" IsCancel="True" />
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Browsers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrowserRowViewModel">
                        <Border BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource SystemChromeLowColor}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Row="0" Grid.Column="1" Content="{Binding AddButtonText}"
                                        Classes="brand"
                                        Command="{Binding $parent[ItemsControl].((vm:BrowserSetupViewModel)DataContext).OpenStorePageCommand}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Status}" Opacity="0.75" TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

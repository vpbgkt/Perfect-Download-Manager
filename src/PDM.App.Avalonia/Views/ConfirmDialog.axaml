<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDM.App.Avalonia.Views.ConfirmDialog"
        Width="400" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="NoButton" Content="No" Click="OnNo" MinWidth="84" IsCancel="True" />
            <Button x:Name="YesButton" Content="Yes" Click="OnYes" MinWidth="84"
                    IsDefault="True" Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        xmlns:conv="using:PDM.App.Avalonia.Converters"
        x:Class="PDM.App.Avalonia.Views.DownloadPopupWindow"
        x:DataType="vm:DownloadPopupViewModel"
        Title="{Binding FileNameDisplay}"
        Width="540" Height="400"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <!-- Root grid: main content + a full-cover shutdown-countdown overlay layered on top. -->
    <Grid>

        <Border Classes="card" Margin="12">

            <!-- Tabs sit at the very top; the file identity lives inside the Download tab, below the
                 tab strip (so the tab buttons are above the file name). -->
            <TabControl>

                <!-- Main / Download tab -->
                <TabItem Header="Download">
                    <DockPanel Margin="0,10,0,0">

                        <!-- ===== Identity: real file icon + name + status pill ===== -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                    Background="{DynamicResource AppAccentSubtleBrush}">
                                <Panel>
                                    <!-- Generic fallback glyph sits under the real icon; the icon
                                         covers it when the shell resolves one for this file. -->
                                    <TextBlock Classes="glyph" Text="&#xE896;" FontSize="20"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppAccentBrush}" />
                                    <Image Width="28" Height="28"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Source="{Binding DestinationPath, Converter={x:Static conv:FileIconConverter.Instance}, ConverterParameter=large}" />
                                </Panel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="6">
                                <TextBlock Text="{Binding FileNameDisplay}" Classes="h2"
                                           TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                <Border Classes="badge" Background="{DynamicResource AppAccentSubtleBrush}"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11.5"
                                               Foreground="{DynamicResource AppAccentBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Controls pinned to the bottom of the tab. Order (when complete):
                             Open · Extract and open · Show in folder · Close. Each closes the popup. -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Open" Click="OnOpenAndClose"
                                    IsVisible="{Binding CanOpenFile}" Classes="brand" />
                            <Button Content="Extract and open" Click="OnExtractAndOpen"
                                    IsVisible="{Binding CanExtract}" Classes="brand" />
                            <Button Content="Show in folder" Click="OnShowFolderAndClose"
                                    IsVisible="{Binding CanOpenFolder}" />

                            <!-- Running + archive: arm auto-extract (asks the password up front). -->
                            <Button Content="Auto extract and open" Click="OnArmAutoExtract"
                                    IsVisible="{Binding CanArmAutoExtract}"
                                    ToolTip.Tip="Extract this archive and open the folder automatically when the download finishes" />

                            <!-- Paused: keep the download for later (closes without cancelling). -->
                            <Button Content="Download later" Click="OnCloseClick"
                                    IsVisible="{Binding IsPaused}"
                                    ToolTip.Tip="Close this window and keep the download paused so you can resume it later" />

                            <Button Content="Resume" Command="{Binding ResumeCommand}"
                                    IsVisible="{Binding CanResume}" Classes="brand" />
                            <Button Content="Pause" Command="{Binding PauseCommand}"
                                    IsVisible="{Binding CanPause}" Classes="brand" />
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    IsVisible="{Binding CanCancel}" />
                            <Button Content="Close" Click="OnCloseClick"
                                    IsVisible="{Binding IsTerminal}" />
                        </StackPanel>

                        <StackPanel Spacing="12">

                            <!-- Progress (smoothly animated) -->
                            <StackPanel Spacing="6">
                                <ProgressBar x:Name="ProgressIndicator" Minimum="0" Maximum="100"
                                             Value="{Binding ProgressPercent}"
                                             IsIndeterminate="{Binding IsIndeterminate}"
                                             MinHeight="8" CornerRadius="4">
                                    <ProgressBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Value" Duration="0:0:0.45"
                                                              Easing="CubicEaseOut" />
                                        </Transitions>
                                    </ProgressBar.Transitions>
                                </ProgressBar>
                                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                                           Classes="secondary" FontSize="11" HorizontalAlignment="Right" />
                            </StackPanel>

                            <!-- Intelligent status message (explains stalls/slowdowns). -->
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />

                            <!-- Armed auto-extract indicator. -->
                            <Border IsVisible="{Binding AutoExtractWhenDone}"
                                    Background="{DynamicResource AppAccentSubtleBrush}"
                                    CornerRadius="7" Padding="9,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="glyph" Text="&#xE8B7;" FontSize="14"
                                               Foreground="{DynamicResource AppAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="This archive will be extracted and opened automatically when the download finishes."
                                               TextWrapping="Wrap" FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Live metrics (hidden once terminal). -->
                            <Grid ColumnDefinitions="*,*,*,*" IsVisible="{Binding ShowLiveMetrics}">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Classes="section" Text="TRANSFERRED" />
                                    <TextBlock Text="{Binding DownloadedText}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Classes="section" Text="SPEED" />
                                    <TextBlock Text="{Binding SpeedText}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock Classes="section" Text="TIME LEFT" />
                                    <TextBlock Text="{Binding EtaText}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="3">
                                    <TextBlock Classes="section" Text="LINKS" />
                                    <TextBlock Text="{Binding ConnectionsText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <!-- Free/limited-plan speed notice (only while unlicensed). -->
                            <Border IsVisible="{Binding IsLimitedPlan}"
                                    Background="{DynamicResource StatusWarningSubtleBrush}"
                                    CornerRadius="7" Padding="9,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="glyph" Text="&#xE7BA;" FontSize="14"
                                               Foreground="{DynamicResource StatusWarningBrush}" />
                                    <TextBlock Text="{Binding LimitedPlanNotice}" TextWrapping="Wrap"
                                               FontSize="11.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </TabItem>

                <!-- Options tab -->
                <TabItem Header="Options">
                    <StackPanel Margin="0,12,0,0" Spacing="12">
                        <TextBlock Text="When the download finishes" Classes="section" />
                        <CheckBox IsChecked="{Binding AutoOpenOnComplete}"
                                  Content="Open the file automatically" />
                        <CheckBox IsChecked="{Binding ShutdownWhenDone}"
                                  Content="Shut down the PC (with a 10-second cancel window)" />
                        <TextBlock Text="More options will appear here in future updates."
                                   Classes="caption" Margin="0,6,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ===== Shutdown countdown overlay (shown by code-behind after completion) ===== -->
        <Border x:Name="ShutdownOverlay" IsVisible="False"
                Background="#B0000000">
            <Border Classes="card" MaxWidth="320" Margin="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24,20">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="14"
                            Background="{DynamicResource AppAccentSubtleBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Classes="glyph" Text="&#xE7E8;" FontSize="24"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                    </Border>
                    <TextBlock Text="Shutting down" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ShutdownCountdownText" Classes="secondary"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Cancel shutdown" Classes="brand" Click="OnCancelShutdown"
                            HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

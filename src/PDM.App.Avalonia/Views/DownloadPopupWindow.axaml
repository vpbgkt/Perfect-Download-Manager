<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        x:Class="PDM.App.Avalonia.Views.DownloadPopupWindow"
        x:DataType="vm:DownloadPopupViewModel"
        Title="{Binding FileNameDisplay}"
        Width="460" Height="300"
        MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- Identity -->
        <TextBlock Grid.Row="0" Text="{Binding FileNameDisplay}"
                   FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Text="{Binding SourceUrlDisplay}" Opacity="0.7"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,10" />

        <!-- Progress -->
        <ProgressBar Grid.Row="2" Minimum="0" Maximum="100"
                     Value="{Binding ProgressPercent}"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Height="10" />

        <!-- Status + live metrics -->
        <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="{Binding StatusLabel}" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14"
                        HorizontalAlignment="Right" IsVisible="{Binding ShowLiveMetrics}">
                <TextBlock Text="{Binding DownloadedText}" />
                <TextBlock Text="{Binding SpeedText}" />
                <TextBlock Text="{Binding EtaText}" />
                <TextBlock Text="{Binding ConnectionsText}" />
            </StackPanel>
        </Grid>

        <!-- Failure detail -->
        <SelectableTextBlock Grid.Row="4" Text="{Binding FailureMessage}"
                             IsVisible="{Binding IsFailed}" TextWrapping="Wrap"
                             Foreground="{DynamicResource SystemErrorTextColor}" Margin="0,10,0,0" />

        <!-- Controls -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open" Command="{Binding OpenFileCommand}"
                    IsVisible="{Binding CanOpenFile}" />
            <Button Content="Show in folder" Command="{Binding OpenFolderCommand}"
                    IsVisible="{Binding CanOpenFolder}" />
            <Button Content="Resume" Command="{Binding ResumeCommand}"
                    IsEnabled="{Binding CanResume}" />
            <Button Content="Pause" Command="{Binding PauseCommand}"
                    IsEnabled="{Binding CanPause}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}"
                    IsEnabled="{Binding CanCancel}" />
        </StackPanel>
    </Grid>
</Window>

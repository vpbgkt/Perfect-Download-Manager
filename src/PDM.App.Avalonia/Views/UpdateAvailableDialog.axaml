<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        x:Class="PDM.App.Avalonia.Views.UpdateAvailableDialog"
        x:DataType="vm:UpdateAvailableViewModel"
        Title="Update available"
        Width="560" Height="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">

        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SizeText}" Opacity="0.7" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                         IsVisible="{Binding IsDownloading}" Height="8" />
            <TextBlock Text="{Binding StatusText}" Opacity="0.8"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource SystemErrorTextColor}"
                                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Later" MinWidth="90" Click="OnLater" IsCancel="True" />
                <Button Content="Download and install" MinWidth="160"
                        Command="{Binding DownloadCommand}"
                        IsEnabled="{Binding !IsDownloading}" IsVisible="{Binding !IsComplete}"
                        Classes="accent" />
                <Button Content="Restart now" MinWidth="120" Click="OnRestart"
                        IsVisible="{Binding IsComplete}" Classes="accent" />
            </StackPanel>
        </StackPanel>

        <Border BorderThickness="1" CornerRadius="4" Margin="0,12,0,0"
                BorderBrush="{DynamicResource SystemChromeLowColor}">
            <ScrollViewer Padding="10">
                <SelectableTextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDM.App.Avalonia.Views.DeleteConfirmationDialog"
        Title="Remove download"
        Width="440" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <CheckBox x:Name="DeleteFilesCheck" Content="Also delete the downloaded file from disk" IsChecked="True" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" MinWidth="90" Click="OnCancel" IsCancel="True" />
            <Button Content="Remove" MinWidth="90" Click="OnConfirm" IsDefault="True" Classes="danger" />
        </StackPanel>
    </StackPanel>
</Window>

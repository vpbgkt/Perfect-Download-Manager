<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDM.App.Avalonia.Views.DuplicatePromptDialog"
        Width="460" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Click="OnCancel" IsCancel="True" />
            <Button x:Name="SecondaryButton" MinWidth="120" Click="OnSecondary" />
            <Button x:Name="PrimaryButton" MinWidth="120" Click="OnPrimary" IsDefault="True" Classes="brand" />
        </StackPanel>
    </StackPanel>
</Window>

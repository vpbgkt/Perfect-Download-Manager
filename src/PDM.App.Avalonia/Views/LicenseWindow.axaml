<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        x:Class="PDM.App.Avalonia.Views.LicenseWindow"
        x:DataType="vm:LicenseViewModel"
        Title="License"
        Width="560" Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" />

        <TextBlock Text="{Binding Message}" Opacity="0.75" TextWrapping="Wrap"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Text="License key" IsVisible="{Binding !IsActivated}" />
        <TextBox Text="{Binding LicenseKey}"
                 Watermark="PDM-XXXX-XXXX-XXXX-XXXX"
                 IsEnabled="{Binding !IsWorking}"
                 IsVisible="{Binding !IsActivated}" />

        <TextBlock Text="Machine fingerprint (bound at activation)" FontSize="12" Opacity="0.7" Margin="0,6,0,0" />
        <TextBox Text="{Binding Fingerprint}" IsReadOnly="True"
                 FontFamily="Consolas,Cascadia Mono,monospace" FontSize="11" />

        <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,6,0,0"
                   Text="Need a license, a renewal, or help? Contact the PDM team." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Contact / Renew" MinWidth="120" Click="OnContactSupport" />
            <Button Content="Close" MinWidth="96" Click="OnClose" IsCancel="True" />
            <Button Content="Deactivate" MinWidth="120" Classes="danger"
                    Command="{Binding DeactivateCommand}" IsVisible="{Binding IsActivated}" />
            <Button Content="Activate" MinWidth="120" Classes="accent" IsDefault="True"
                    Command="{Binding ActivateCommand}" IsVisible="{Binding !IsActivated}" />
        </StackPanel>
    </StackPanel>
</Window>

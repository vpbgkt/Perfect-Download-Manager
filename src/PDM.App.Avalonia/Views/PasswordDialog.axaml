<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PDM.App.Avalonia.Views.PasswordDialog"
        Title="Password required"
        Width="460" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <StackPanel Margin="24" Spacing="18">

        <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Width="44" Height="44" CornerRadius="12"
                    Background="{DynamicResource AppAccentSubtleBrush}">
                <TextBlock Classes="glyph" Text="&#xE72E;" FontSize="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppAccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="h2" Text="This archive is protected" />
                <TextBlock x:Name="ArchiveNameText" Classes="caption" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="7">
            <TextBlock Classes="section" Text="PASSWORD" />
            <TextBox x:Name="PasswordBox" PasswordChar="●" Watermark="Enter the archive password"
                     KeyDown="OnPasswordKeyDown" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Cancel" MinWidth="96" Click="OnCancel" IsCancel="True" />
            <Button Content="Extract" MinWidth="110" Classes="brand" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        xmlns:views="using:PDM.App.Avalonia.Views"
        x:Class="PDM.App.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding AppTitle}"
        Width="1040" Height="660"
        MinWidth="760" MinHeight="460">

    <Window.Styles>
        <!-- Toolbar buttons: compact, quiet chrome that reads well in both light and dark. -->
        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <!-- Category rows: comfortable spacing + rounded selection. -->
        <Style Selector="ListBox.categories ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="DataGrid#DownloadsGrid">
            <Setter Property="RowHeight" Value="44" />
        </Style>
        <!-- Monochrome Fluent icon glyphs (follow the theme foreground). Segoe Fluent Icons on
             Win11, Segoe MDL2 Assets on Win10 - both ship with Windows. -->
        <Style Selector="TextBlock.glyph">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ================= Toolbar ================= -->
        <Border DockPanel.Dock="Top" Classes="toolbar" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Primary, frequently used actions (icons + labels) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="OnAddDownload" Classes="accent" ToolTip.Tip="Add a new download">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE710;" />
                            <TextBlock Text="Add download" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Resume and Pause are mutually exclusive per the selected download's state. -->
                    <Button Command="{Binding ResumeCommand}" CommandParameter="{Binding SelectedItem}"
                            IsVisible="{Binding SelectedItem.CanResume}" ToolTip.Tip="Resume">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE768;" />
                            <TextBlock Text="Resume" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PauseCommand}" CommandParameter="{Binding SelectedItem}"
                            IsVisible="{Binding SelectedItem.CanPause}" ToolTip.Tip="Pause">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE769;" />
                            <TextBlock Text="Pause" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnDeleteSelected" IsEnabled="{Binding HasSelection}"
                            ToolTip.Tip="Delete the selected downloads">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE74D;" />
                            <TextBlock Text="Delete selected" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="4,2" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                    <!-- Opens a detected browser; the dropdown lists all and remembers the choice. -->
                    <SplitButton x:Name="OpenBrowserButton" Click="OnOpenBrowser"
                                 ToolTip.Tip="Open a web browser">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE774;" />
                            <TextBlock Text="Open browser" VerticalAlignment="Center" />
                        </StackPanel>
                    </SplitButton>
                </StackPanel>

                <!-- Search -->
                <TextBox Grid.Column="2" Width="240" Watermark="Search downloads..."
                         Text="{Binding SearchText}" VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Overflow / advanced actions -->
                <Button Grid.Column="3" VerticalAlignment="Center" ToolTip.Tip="More actions">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="More" VerticalAlignment="Center" />
                        <TextBlock Classes="glyph" Text="&#xE70D;" FontSize="12" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Bulk add..." Click="OnBulkAdd" />
                            <Separator />
                            <MenuItem Header="Open" Click="OnMoreOpen" />
                            <MenuItem Header="Show in folder" Click="OnMoreShowFolder" />
                            <MenuItem Header="Show popup" Click="OnMoreShowPopup" />
                            <MenuItem Header="Change link..." Click="OnChangeUrl" />
                            <MenuItem Header="Refresh from browser" Click="OnRefreshFromBrowser" />
                            <Separator />
                            <MenuItem Header="Settings" Click="OnOpenSettings" />
                            <MenuItem Header="License" Click="OnOpenLicense" />
                            <MenuItem Header="Browser setup" Click="OnBrowserSetup" />
                            <MenuItem Header="Check for updates" Click="OnCheckForUpdates" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ================= Categories sidebar ================= -->
        <Border DockPanel.Dock="Left" Width="210" Classes="sidebar"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <ListBox Classes="categories" Background="Transparent"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryFilterItem">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ================= Downloads list + empty state ================= -->
        <Grid Margin="4">
            <!-- ItemsSource is assigned in code-behind to a DataGridCollectionView so the shared
                 MainViewModel's FilterItem predicate + FilterChanged signal drive filtering.
                 Column bindings are compiled via x:DataType. -->
            <DataGrid x:Name="DownloadsGrid"
                      SelectedItem="{Binding SelectedItem}"
                      IsReadOnly="True"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.ContextMenu>
                    <ContextMenu x:DataType="vm:MainViewModel">
                        <MenuItem Header="Resume" Command="{Binding ResumeCommand}"
                                  CommandParameter="{Binding SelectedItem}" />
                        <MenuItem Header="Pause" Command="{Binding PauseCommand}"
                                  CommandParameter="{Binding SelectedItem}" />
                        <Separator />
                        <MenuItem Header="Open" Command="{Binding OpenFileCommand}"
                                  CommandParameter="{Binding SelectedItem}" />
                        <MenuItem Header="Show in folder" Command="{Binding OpenFolderCommand}"
                                  CommandParameter="{Binding SelectedItem}" />
                        <MenuItem Header="Show popup" Command="{Binding ShowPopupCommand}"
                                  CommandParameter="{Binding SelectedItem}" />
                        <Separator />
                        <MenuItem Header="Change link..." Click="OnChangeUrl" />
                        <MenuItem Header="Refresh from browser" Click="OnRefreshFromBrowser" />
                        <Separator />
                        <MenuItem Header="Remove..." Click="OnRemoveSelected" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- Selection checkbox (header toggles all) -->
                    <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserReorder="False">
                        <DataGridTemplateColumn.Header>
                            <CheckBox Click="OnToggleSelectAll" Margin="4,0,0,0" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="4,0,0,0"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Name with app icon -->
                    <DataGridTemplateColumn Header="Name" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Image Width="20" Height="20" VerticalAlignment="Center"
                                           Source="{x:Static views:MainWindow.AppIcon}" />
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Status" Width="120"
                                        Binding="{Binding StatusLabel}" x:DataType="vm:DownloadItemViewModel" />
                    <DataGridTemplateColumn Header="Progress" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                <Grid VerticalAlignment="Center">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                                 Height="6" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Width="110"
                                        Binding="{Binding SizeText}" x:DataType="vm:DownloadItemViewModel" />
                    <DataGridTextColumn Header="Speed" Width="110"
                                        Binding="{Binding SpeedText}" x:DataType="vm:DownloadItemViewModel" />
                    <DataGridTextColumn Header="ETA" Width="90"
                                        Binding="{Binding EtaText}" x:DataType="vm:DownloadItemViewModel" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel IsVisible="{Binding IsListEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Image Width="56" Height="56" Opacity="0.5" HorizontalAlignment="Center"
                       Source="{x:Static views:MainWindow.AppIcon}" />
                <TextBlock Text="{Binding EmptyStateTitle}" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyStateHint}" Opacity="0.7"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

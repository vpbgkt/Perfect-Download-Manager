<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PDM.App.ViewModels"
        xmlns:views="using:PDM.App.Avalonia.Views"
        xmlns:conv="using:PDM.App.Avalonia.Converters"
        x:Class="PDM.App.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding AppTitle}"
        Width="1120" Height="700"
        MinWidth="820" MinHeight="500"
        Background="{DynamicResource AppWindowBackgroundBrush}">

    <DockPanel>

        <!-- ================= Sidebar (collapsible) ================= -->
        <!-- The toggle flips SidebarToggle.IsChecked (checked = collapsed). The Border width is
             animated by a DoubleTransition, and the labels/brand text hide when collapsed so only
             the icons remain. Label visibility binds to the toggle by name (ElementName), which works
             inside the compiled item template regardless of its x:DataType. -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="232"
                Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderThickness="0,0,1,0" BorderBrush="{DynamicResource AppDividerBrush}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>
            <!-- LastChildFill is off so the category list sizes to its content and the Downloads
                 folder button can sit directly after it; the brand/plan badges stay pinned to the
                 bottom. -->
            <DockPanel Margin="8,12,8,12" LastChildFill="False">

                <!-- Header: collapse toggle in front of the LIBRARY heading. The heading hides while
                     collapsed, leaving just the toggle so the user can expand again. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="4,0,4,12">
                    <ToggleButton x:Name="SidebarToggle" Classes="ghost"
                                  Click="OnToggleSidebar" VerticalAlignment="Center"
                                  Padding="8" ToolTip.Tip="Collapse or expand the sidebar">
                        <TextBlock Classes="glyph" Text="&#xE700;" FontSize="16" />
                    </ToggleButton>
                    <TextBlock Text="LIBRARY" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               IsVisible="{Binding !IsChecked, ElementName=SidebarToggle}" />
                </StackPanel>

                <!-- Plan badge: always visible above the brand. Premium shows an accent badge;
                     free/limited shows a subtle warning badge. Text hides when the sidebar collapses,
                     leaving just the status glyph. -->
                <Border DockPanel.Dock="Bottom" Margin="4,0,4,10" CornerRadius="10" Padding="10,8"
                        Background="{DynamicResource AppAccentSubtleBrush}"
                        IsVisible="{Binding LicenseBanner.IsPremiumPlan}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="glyph" Text="&#xE735;" FontSize="16"
                                   Foreground="{DynamicResource AppAccentBrush}" />
                        <TextBlock Text="{Binding LicenseBanner.PlanName}" FontWeight="SemiBold" FontSize="12.5"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   IsVisible="{Binding !IsChecked, ElementName=SidebarToggle}" />
                    </StackPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" Margin="4,0,4,10" CornerRadius="10" Padding="10,8"
                        Background="{DynamicResource StatusWarningSubtleBrush}"
                        IsVisible="{Binding !LicenseBanner.IsPremiumPlan}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="glyph" Text="&#xE7BA;" FontSize="16"
                                   Foreground="{DynamicResource StatusWarningBrush}" />
                        <StackPanel VerticalAlignment="Center"
                                    IsVisible="{Binding !IsChecked, ElementName=SidebarToggle}">
                            <TextBlock Text="{Binding LicenseBanner.PlanName}" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Upgrade for full speed" Classes="caption" Margin="0,-1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Brand pinned to the bottom; text hides when collapsed, leaving the logo only. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10"
                            Margin="6,12,6,2" VerticalAlignment="Center">
                    <Image Width="26" Height="26" VerticalAlignment="Center"
                           Source="{x:Static views:MainWindow.AppIcon}" />
                    <StackPanel VerticalAlignment="Center"
                                IsVisible="{Binding !IsChecked, ElementName=SidebarToggle}">
                        <TextBlock Text="Perfect" FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Download Manager" Classes="caption" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>

                <ListBox DockPanel.Dock="Top" Classes="categories" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoryFilterItem">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <TextBlock Classes="glyph" Text="{Binding Glyph}" FontSize="16"
                                           Width="18" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsChecked, ElementName=SidebarToggle}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Quick access to the PDM downloads folder. Placed at the end of the LIBRARY
                     list, set off by a light divider line above it so it does not read as a
                     category. Label hides when the sidebar is collapsed. -->
                <Border DockPanel.Dock="Top" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource AppDividerBrush}"
                        Margin="0,8,0,0" Padding="0,8,0,0">
                    <Button Classes="ghost" Click="OnOpenDownloadsFolder"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="12,9"
                            ToolTip.Tip="Open the PDM downloads folder">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Classes="glyph" Text="&#xE838;" FontSize="16"
                                       Width="18" TextAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="Downloads folder" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsChecked, ElementName=SidebarToggle}" />
                        </StackPanel>
                    </Button>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================= License expiration warning bar ================= -->
        <!-- Shown only while the license banner is in a warning state (e.g. within the configured
             expiry window). Clicking it opens the license details. -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding LicenseBanner.IsWarning}"
                Background="{DynamicResource StatusWarningSubtleBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppDividerBrush}"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0" Classes="glyph" Text="&#xE7BA;" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource StatusWarningBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding LicenseBanner.StatusText}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <TextBlock Text="{Binding LicenseBanner.DetailText}" Classes="caption" />
                </StackPanel>
                <Button Grid.Column="2" Classes="brand" Click="OnOpenLicense"
                        Content="{Binding LicenseBanner.ActionLabel}"
                        IsVisible="{Binding LicenseBanner.IsActionVisible}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ================= Toolbar ================= -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppToolbarBackgroundBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AppDividerBrush}"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Primary, frequently used actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Add download: primary click adds one; the dropdown holds Bulk add (mirrors the
                         Open browser split-button pattern) so advanced adds stay one click away. -->
                    <SplitButton Click="OnAddDownload" Classes="brand" ToolTip.Tip="Add a new download">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE710;" />
                            <TextBlock Text="Add download" VerticalAlignment="Center" />
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Add download..." Click="OnAddDownload" />
                                <MenuItem Header="Bulk add..." Click="OnBulkAdd" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Resume and Pause are mutually exclusive per the selected download's state. -->
                    <Button Command="{Binding ResumeCommand}" CommandParameter="{Binding SelectedItem}"
                            IsVisible="{Binding SelectedItem.CanResume}" ToolTip.Tip="Resume">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE768;" />
                            <TextBlock Text="Resume" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PauseCommand}" CommandParameter="{Binding SelectedItem}"
                            IsVisible="{Binding SelectedItem.CanPause}" ToolTip.Tip="Pause">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE769;" />
                            <TextBlock Text="Pause" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnDeleteSelected" IsVisible="{Binding HasSelection}"
                            ToolTip.Tip="Delete the selected downloads">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE74D;" />
                            <TextBlock Text="Delete" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="4,2" Background="{DynamicResource AppDividerBrush}" />

                    <!-- Opens a detected browser; the dropdown lists all and remembers the choice. -->
                    <SplitButton x:Name="OpenBrowserButton" Click="OnOpenBrowser"
                                 ToolTip.Tip="Open a web browser">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE774;" />
                            <TextBlock Text="Open browser" VerticalAlignment="Center" />
                        </StackPanel>
                    </SplitButton>
                </StackPanel>

                <!-- Search -->
                <Border Grid.Column="2" Width="260" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid>
                        <TextBlock Classes="glyph" Text="&#xE721;" FontSize="14"
                                   Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" IsHitTestVisible="False" />
                        <TextBox Text="{Binding SearchText}" Watermark="Search downloads"
                                 Padding="32,7,10,7" />
                    </Grid>
                </Border>

                <!-- Overflow / advanced actions -->
                <Button Grid.Column="3" Classes="ghost" VerticalAlignment="Center" ToolTip.Tip="More actions">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="More" VerticalAlignment="Center" />
                        <TextBlock Classes="glyph" Text="&#xE70D;" FontSize="12" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Settings" Click="OnOpenSettings" />
                            <MenuItem Header="License" Click="OnOpenLicense" />
                            <MenuItem Header="Browser setup" Click="OnBrowserSetup" />
                            <MenuItem Header="Check for updates" Click="OnCheckForUpdates" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- ================= Downloads list + empty state ================= -->
        <Grid Margin="16">
            <Border Classes="card" Padding="6" IsVisible="{Binding !IsListEmpty}">
                <!-- ItemsSource is assigned in code-behind to a DataGridCollectionView so the shared
                     MainViewModel's FilterItem predicate + FilterChanged signal drive filtering.
                     Column bindings are compiled via x:DataType. -->
                <DataGrid x:Name="DownloadsGrid"
                          SelectedItem="{Binding SelectedItem}"
                          IsReadOnly="True"
                          RowHeight="44"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          HeadersVisibility="Column"
                          DoubleTapped="OnRowDoubleTapped">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:DataType="vm:MainViewModel">
                            <!-- Transfer actions appear only when they apply to the selected row:
                                 Resume when paused/failed, Pause when active, and Refresh from
                                 browser only while the download is not yet complete. -->
                            <MenuItem Header="Resume" Command="{Binding ResumeCommand}"
                                      CommandParameter="{Binding SelectedItem}"
                                      IsVisible="{Binding SelectedItem.CanResume}" />
                            <MenuItem Header="Pause" Command="{Binding PauseCommand}"
                                      CommandParameter="{Binding SelectedItem}"
                                      IsVisible="{Binding SelectedItem.CanPause}" />
                            <MenuItem Header="Refresh from browser" Click="OnRefreshFromBrowser"
                                      IsVisible="{Binding SelectedItem.CanRefreshLink}" />
                            <Separator IsVisible="{Binding SelectedItem.CanRefreshLink}" />
                            <MenuItem Header="Open" Command="{Binding OpenFileCommand}"
                                      CommandParameter="{Binding SelectedItem}" />
                            <MenuItem Header="Extract and open" Click="OnExtractAndOpen"
                                      IsVisible="{Binding SelectedItem.CanExtract}" />
                            <MenuItem Header="Show in folder" Command="{Binding OpenFolderCommand}"
                                      CommandParameter="{Binding SelectedItem}" />
                            <MenuItem Header="Show popup" Command="{Binding ShowPopupCommand}"
                                      CommandParameter="{Binding SelectedItem}" />
                            <MenuItem Header="Change link..." Click="OnChangeUrl" />
                            <Separator />
                            <MenuItem Header="Remove..." Click="OnRemoveSelected" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <!-- Selection column. The header holds an unlabelled "select all" checkbox;
                             clicking it selects or clears every row. It is driven from code-behind
                             (a column header is outside compiled-binding scope), and PointerPressed is
                             marked handled so the DataGrid header does not capture the click first. -->
                        <DataGridTemplateColumn Width="40" CanUserResize="False"
                                                CanUserReorder="False" CanUserSort="False">
                            <DataGridTemplateColumn.Header>
                                <!-- Transparent border fills the header cell and takes the click; the
                                     checkbox is display-only (IsHitTestVisible=False) so the DataGrid
                                     header can never steal its click. Toggling happens on press. -->
                                <Border Background="Transparent" ToolTip.Tip="Select all"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        PointerPressed="OnSelectAllPointerPressed">
                                    <CheckBox x:Name="SelectAllCheckBox" IsHitTestVisible="False"
                                              Margin="4,0,0,0" VerticalAlignment="Center" />
                                </Border>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="4,0,0,0"
                                              VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name (important): real file icon + filename. Star-sized with a firm
                             MinWidth so it stays readable while the window narrows. -->
                        <DataGridTemplateColumn Header="Name" Width="3*" MinWidth="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="9"
                                                VerticalAlignment="Center" Margin="4,0,0,0">
                                        <!-- The file's real shell icon (per extension, or the file's
                                             own embedded icon once it exists). -->
                                        <Image Width="18" Height="18" VerticalAlignment="Center"
                                               Source="{Binding DestinationPath, Converter={x:Static conv:FileIconConverter.Instance}}" />
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status (important): pill badge. Fixed so it stays visible. -->
                        <DataGridTemplateColumn Header="Status" Width="120" MinWidth="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <Border Classes="badge"
                                            Background="{Binding Status, Converter={x:Static conv:StatusBrushConverter.Instance}, ConverterParameter=bg}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={x:Static conv:StatusBrushConverter.Instance}}" />
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11.5"
                                                       Foreground="{Binding Status, Converter={x:Static conv:StatusBrushConverter.Instance}}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Size (important): fixed so it stays visible. -->
                        <DataGridTextColumn Header="Size" Width="92" MinWidth="78"
                                            Binding="{Binding SizeText}" x:DataType="vm:DownloadItemViewModel" />

                        <!-- Progress / Speed / ETA (secondary): star-sized with small MinWidths so
                             they give up space first as the window narrows. -->
                        <DataGridTemplateColumn Header="Progress" Width="2*" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                                    <StackPanel VerticalAlignment="Center" Spacing="3" Margin="0,0,8,0">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                                     MinHeight="5" />
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                                                   FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Speed" Width="1*" MinWidth="58"
                                            Binding="{Binding SpeedText}" x:DataType="vm:DownloadItemViewModel" />
                        <DataGridTextColumn Header="ETA" Width="1*" MinWidth="54"
                                            Binding="{Binding EtaText}" x:DataType="vm:DownloadItemViewModel" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Beautiful empty state -->
            <Border Classes="card" IsVisible="{Binding IsListEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="48,40" MaxWidth="440">
                <StackPanel HorizontalAlignment="Center" Spacing="14">
                    <Border Width="88" Height="88" CornerRadius="24"
                            Background="{DynamicResource AppAccentSubtleBrush}"
                            HorizontalAlignment="Center">
                        <Image Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Source="{x:Static views:MainWindow.AppIcon}" />
                    </Border>
                    <TextBlock Text="{Binding EmptyStateTitle}" Classes="h1"
                               HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateHint}" Classes="secondary"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Classes="brand" Click="OnAddDownload" HorizontalAlignment="Center"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="glyph" Text="&#xE710;" />
                            <TextBlock Text="Add your first download" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>

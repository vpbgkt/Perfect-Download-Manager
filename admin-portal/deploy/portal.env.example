# Production secrets for the Admin & Reseller Portal on the VPS.
#
# This file is NOT read by npm/Next.js directly here in the repo — it is a template.
# On the VPS it must live at /etc/pdm-portal/portal.env (root-owned, mode 600, readable
# only by the pdmportal service account) and is loaded by systemd via
# `EnvironmentFile=-/etc/pdm-portal/portal.env` in pdm-portal.service.
#
# NEVER commit a filled-in copy of this file. Fill it in directly on the VPS with a
# text editor (nano/vim over SSH) — do not paste real secret values into chat, tickets,
# or any client that logs input.

# --- Firebase Web App config (public; identifies the project, not a secret) ---
# Firebase console -> Project settings -> Your apps -> Web app. Must match what
# admin.perfectdownloadmanager.com is authorized for (Authentication -> Settings ->
# Authorized domains).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server-side ID-token verification) ---
# Path to the service-account JSON on the VPS (NOT inside the git checkout).
# Copy the same file you use locally to /etc/pdm-portal/firebase-service-account.json,
# then: chmod 600 + chown pdmportal:pdmportal it.
GOOGLE_APPLICATION_CREDENTIALS=/etc/pdm-portal/firebase-service-account.json

# --- Resend (email-OTP delivery) ---
RESEND_API_KEY=
OTP_EMAIL_FROM=PDM Portal <noreply@perfectdownloadmanager.com>

# --- AWS (DynamoDB / SSM / S3) ---
# The VPS has no local AWS CLI profile (unlike your dev machine, where `aws configure`
# already set one up), so explicit keys are required here. Use a DEDICATED IAM user
# scoped to exactly admin-portal/deploy/iam-policy.json — never root/admin keys.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Release publishing: existing S3 bucket + SSM signing key (already provisioned;
# these are resource identifiers, not secrets themselves).
RELEASE_BUCKET=pdm-updates-452359090613-aps1
UPDATES_SIGNING_KEY_PARAM=/pdm/updates/private-key

# --- MODE ---
# Real AWS DynamoDB in production. Never set PORTAL_LOCAL_DEV=1 on the public VPS.
PORTAL_LOCAL_DEV=0

# Leave OTP enforced in production (do NOT set PORTAL_DISABLE_OTP here).
# PORTAL_DISABLE_OTP=1

# Next.js server bind (matches the systemd unit's Environment= lines; harmless if
# duplicated here since systemd's own Environment= takes precedence).
PORT=3001
HOST=127.0.0.1
NODE_ENV=production

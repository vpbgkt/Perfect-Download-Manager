# Copy to .env.local and fill in. These enable password-based authentication.

# --- AWS (DynamoDB / SSM / S3) ---
# Required for accessing DynamoDB tables and S3 release storage
AWS_REGION=ap-south-1
# Leave these blank to use AWS CLI profile (~/.aws/credentials)
# Or set explicit credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- JWT Secret (password authentication) ---
# REQUIRED: Generate a strong random secret for production
# Example: openssl rand -hex 32
JWT_SECRET=

# --- Release Publishing ---
# Existing S3 bucket and SSM parameter for update signing
RELEASE_BUCKET=
UPDATES_SIGNING_KEY_PARAM=

# --- Local Development Mode ---
# Set to 1 to use in-memory DynamoDB (no AWS required)
# NEVER enable in production
PORTAL_LOCAL_DEV=0

# --- Local Dev Admin (only used when PORTAL_LOCAL_DEV=1) ---
# Default admin account for local development
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_ROLE=super_admin

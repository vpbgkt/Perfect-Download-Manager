# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
out/
dist/

# dotnet local tool manifest is fine to commit; obfuscated output is not
**/obfuscated/

# WiX toolset extension cache (auto-downloaded per machine)
.wix/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# Test results
[Tt]est[Rr]esults/
*.trx
*.coverage
coverage/

# PDM runtime artifacts (local state — never commit)
downloads/
smoketest/
*.pdmdownload
*.pdmstate

# Temp log files captured during dev
*.log

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# Windows Installer logs
*.msi.log

# Node / backend
node_modules/
backend/**/lambda.zip
# Transient generator/signing scripts written to disk at deploy time (may echo key material)
backend/**/_*.mjs
*.pem

# --- Secrets / signing material — NEVER commit (security-critical) ---
# Code-signing certificate private-key containers (Authenticode / dev certs).
*.pfx
*.p12
*.pvk
*.snk
# Exported certificates (public, but keep cert artefacts out of source control).
*.cer
*.crt
# Private keys / key dumps in any form.
*.key
id_rsa
id_ecdsa
# Signed-token / key scratch outputs (canary, public-key dumps, activation responses).
canary.txt
*.token
license-*.json

# Local scratch
stack-info.json
deploy-out.log
pubkey.txt
testkey.txt
activate-resp.json
vector.json

# WiX debug symbols (build artefact, no use in source control)
*.wixpdb

# Bootstrapper build inputs (downloaded .NET runtime + generated remote-payload fragment)
installer/redist/
installer/runtime-payload.generated.wxs

# Kiro / agent scratch reads
temp_read.txt

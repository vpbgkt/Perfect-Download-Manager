<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 Burn bootstrapper for Perfect Download Manager.

  Produces a single setup .exe that installs the PDM MSI. Since the Avalonia head is published with
  NativeAOT (self-contained, runtime-free), the bundle NO LONGER downloads or installs the .NET
  Desktop Runtime - that whole step (and its ~60 MB payload) is gone. The bundle now exists only to
  give users a familiar single "Setup.exe" wrapper around the MSI; the MSI alone is fully sufficient.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="Perfect Download Manager"
          Manufacturer="Perfect Download Manager"
          Version="$(var.ProductVersion)"
          UpgradeCode="E7B4A2C1-6D3F-4A9E-8C1B-2F3A4B5C6D7E"
          IconSourceFile="pdm.ico"
          AboutUrl="https://perfectdownloadmanager.com/">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          LicenseFile="License.rtf"
          LogoFile="pdm.ico"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <!-- The self-contained PDM installer, embedded in the bundle. No runtime prerequisite. -->
      <MsiPackage
          Id="PdmMsi"
          SourceFile="$(var.MsiPath)"
          Vital="yes"
          Compressed="yes" />
    </Chain>
  </Bundle>
</Wix>
